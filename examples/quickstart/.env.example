# Copy this file to .env and fill in the three values. Keep .env out of version control.

# The database password. Use letters and digits only, because it goes into a connection string.
POSTGRES_PASSWORD=

# The app creates this admin on first boot. The password needs at least 10 characters.
CODEX_ADMIN_EMAIL=
CODEX_ADMIN_PASSWORD=

# Optional. To pin the images for production, set these to a commit tag.
# CODEX_IMAGE=ghcr.io/codexsuite/codex:latest
# CODEX_WORKER_IMAGE=ghcr.io/codexsuite/codex-worker:latest
